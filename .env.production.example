# ==============================================================
# ReadyScribe Production Configuration (.env)
# Domain: https://readyscribe.zuvigo.com
# ==============================================================

NODE_ENV=production
APP_URL=https://readyscribe.zuvigo.com
APP_NAME=ReadyScribe
LOG_LEVEL=info

# --------------------------------------------------------------
# 1. MySQL Database (Host: 139.59.8.68)
# --------------------------------------------------------------
# You can set DB_* fields, or provide the complete DATABASE_URL
DB_HOST=139.59.8.68
DB_PORT=3306
DB_USER=admin
DB_PASS=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=YOUR_DATABASE_NAME_HERE

# Full DATABASE_URL format (fill in your DB password and database name):
DATABASE_URL="mysql://admin:YOUR_MYSQL_PASSWORD_HERE@139.59.8.68:3306/YOUR_DATABASE_NAME_HERE"

# --------------------------------------------------------------
# 2. Upstash Redis (Serverless & BullMQ Queue)
# --------------------------------------------------------------
# Upstash REST API (for @upstash/redis)
UPSTASH_REDIS_REST_URL=https://settling-emu-77774.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAS_OAAIgcDE5ZDc0NmFlMjY3MGM0ZDBiOTNlMWU5N2M4Y2EwODcxMA

# Upstash TLS TCP URL (for BullMQ queues, IORedis, and worker daemons)
REDIS_URL="rediss://default:gQAAAAAAAS_OAAIgcDE5ZDc0NmFlMjY3MGM0ZDBiOTNlMWU5N2M4Y2EwODcxMA@settling-emu-77774.upstash.io:6379"

# --------------------------------------------------------------
# 3. SMTP2GO Email Service
# --------------------------------------------------------------
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=arbilo
SMTP_PASS=Radiolabs@123
SMTP_SECURE=false
EMAIL_FROM=noreply@zuvigo.com

# --------------------------------------------------------------
# 4. Authentication Secret
# --------------------------------------------------------------
# Generated 32+ character secret (or generate with: openssl rand -base64 32)
AUTH_SECRET=pL9kQ2vN8xZ1wB4mY7tF0sR3jU6hC5eA9dX2qV8nK1w

# --------------------------------------------------------------
# 5. Object Storage (DigitalOcean Spaces / S3 for screenshots)
# --------------------------------------------------------------
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=your_spaces_bucket_name
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com

# --------------------------------------------------------------
# 6. AI Integration (OpenAI or compatible)
# --------------------------------------------------------------
AI_API_KEY=your_openai_or_compatible_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --------------------------------------------------------------
# 7. Optional (Google OAuth & Stripe)
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
