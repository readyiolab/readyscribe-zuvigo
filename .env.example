# ZuvigoScribe — copy to .env and fill secrets
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=ZuvigoScribe
LOG_LEVEL=info

# Use 3307 when Docker Compose maps MySQL (avoids local MySQL on 3306)
DATABASE_URL=mysql://zuvigo:zuvigo@localhost:3307/zuvigo
REDIS_URL=redis://localhost:6379

# openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DigitalOcean Spaces — either SPACES_* or DO_SPACES_* aliases work
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

EMAIL_API_KEY=
EMAIL_FROM=noreply@zuvigo.dev

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
