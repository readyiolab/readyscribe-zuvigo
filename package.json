{
  "name": "zuvigoscribe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @zuvigo/db generate",
    "db:migrate": "pnpm --filter @zuvigo/db migrate:dev",
    "db:seed": "pnpm --filter @zuvigo/db seed",
    "db:studio": "pnpm --filter @zuvigo/db studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "rimraf": "^6.0.1"
  }
}
