{
  "name": "@zuvigo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "dotenv -e ../../.env -e .env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -e .env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -e .env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -e .env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -e .env -- prisma studio",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@zuvigo/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
